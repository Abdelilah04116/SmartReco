# API Configuration
API_KEY=demo-api-key-change-in-production
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost

# Priority Thresholds
PRIORITY_HIGH_THRESHOLD=50
PRIORITY_MEDIUM_THRESHOLD=25
PRIORITY_LOW_THRESHOLD=0

# AI Agent Configuration (Google Gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
AI_AGENT_ENABLED=true









